<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Фон виджета -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FAFAFA"/>
            <stroke android:width="1dp" android:color="#E0E0E0"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Внутренний контент -->
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <layer-list>

            <!-- Верхняя полоса (имитация header) -->
            <item android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1976D2"/>
                    <corners android:radius="8dp"/>
                    <size android:height="32dp"/>
                </shape>
            </item>

            <!-- Отступ -->
            <item android:top="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FAFAFA"/>
                    <size android:height="8dp"/>
                </shape>
            </item>

            <!-- Строка дней недели (имитация) -->
            <item android:top="48dp">
                <layer-list>
                    <!-- 5 блоков для дней -->
                    <item android:left="0dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#E0E0E0"/>
                            <corners android:radius="4dp"/>
                            <size android:height="36dp"/>
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- Отступ -->
            <item android:top="92dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FAFAFA"/>
                    <size android:height="8dp"/>
                </shape>
            </item>

            <!-- Контейнер для логотипа -->
            <item android:top="100dp" android:bottom="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F0F0F0"/>
                    <corners android:radius="12dp"/>
                </shape>
            </item>

            <!-- ВАШ ЛОГОТИП -->
            <item
                android:top="115dp"
                android:bottom="55dp"
                android:left="30dp"
                android:right="30dp"
                android:drawable="@drawable/logo">
            </item>

        <!-- Нижняя полоса (фиксированная высота 28dp) -->
        <item
            android:top="260dp"
                android:bottom="0dp">
            <shape android:shape="rectangle">
                <solid android:color="#1976D2"/>
                <corners android:radius="8dp"/>
            </shape>
        </item>

        </layer-list>
    </item>

</layer-list>